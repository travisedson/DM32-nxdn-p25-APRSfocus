diff --git a/core/aprs/aprs_ax25.c b/core/aprs/aprs_ax25.c
index 0cb2b75..3348415 100644
--- a/core/aprs/aprs_ax25.c
+++ b/core/aprs/aprs_ax25.c
@@ -854,6 +854,25 @@ static bool rx_by_stream(void)
 // try routes the receiver and back
 #define RX_RETRY_MS	1000u
 
+// Stop the receive path now (radio task). The radio core calls it before it tunes away from the APRS frequency: the
+// path holds the board's FM receive audio (on the HR_C7000 the copy interrupt), which a digital mode's engine needs
+// to start, and the service below would only let go of it later in the same poll, after that start had failed
+void aprs_rx_release(void)
+{
+	if (!aprs_s.rx_running) {
+		return;
+	}
+	if (rx_by_board()) {
+		if (board.afsk->rx_stop != NULL) {
+			board.afsk->rx_stop();
+		}
+	} else {
+		audio_mux_aprs_rx(false);
+	}
+	aprs_s.rx_running = false;
+	aprs_s.rx_dcd = false;
+}
+
 // The receive path: on while receiving FM with the setting on (radio task, outside the lock)
 void aprs_ax25_rx_service(const aprs_radio_t *r, uint32_t now_ms)
 {
@@ -876,15 +895,7 @@ void aprs_ax25_rx_service(const aprs_radio_t *r, uint32_t now_ms)
 			audio_mux_aprs_rx(true);
 		}
 	} else if (!want && aprs_s.rx_running) {
-		if (own) {
-			if (h->rx_stop != NULL) {
-				h->rx_stop();
-			}
-		} else {
-			audio_mux_aprs_rx(false);
-		}
-		aprs_s.rx_running = false;
-		aprs_s.rx_dcd = false;
+		aprs_rx_release();
 	}
 	if (!want) {
 		aprs_s.rx_retry_wait = false;	// a refusal's wait is for the try it followed, not a later one
diff --git a/core/radio/radio_sm.c b/core/radio/radio_sm.c
index 58c9e4b..75569aa 100644
--- a/core/radio/radio_sm.c
+++ b/core/radio/radio_sm.c
@@ -751,6 +751,14 @@ static void tune(radio_sm_t *sm, uint32_t now_ms)
 	cw_cancel(sm);		// the repeater's ID: the board is set up for the channel below
 #endif
 	end_reception(sm, now_ms);
+#if CONFIG_APRS_RX
+	// Off the APRS frequency (or out of FM): APRS lets go of the FM receive audio before the board changes mode. A
+	// P25, NXDN or YSF engine can't start while it holds it, and nothing retries the start until the next tune: from
+	// dual watch's APRS side that left the channel with no engine, and PTT refused ("NO TX") until a power cycle
+	if (aprs_rx_listening() && !(sm->view.ch.mode == RADIO_MODE_FM && sm->view.ch.rx_hz == aprs_rx_freq())) {
+		aprs_rx_release();
+	}
+#endif
 	if (radio_listen_band(sm->view.ch.rx_hz)) {
 		// AM or broadcast there, whatever the channel says; the VFO stays FM when it leaves the band. The channel's
 		// own mode follows, so FM there is not a temporary change (dual watch brings a pane back already FM)
diff --git a/tests/host/aprsRadioTest.c b/tests/host/aprsRadioTest.c
