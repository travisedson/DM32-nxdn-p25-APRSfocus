 		on_a += hw.rx_hz == CH_HZ;
 	}
 	CHECK(on_a > 0 && on_aprs >= 2u * on_a && on_aprs <= 4u * on_a);
+	CHECK(pcm.starts > 3 && retune_while_aprs == 0);	// APRS let go before every hop off its frequency
 	// A packet: 450 ms of flags (a long TX delay), the frame, a short tail; well over B's dwell
 	static uint8_t tones[512];
 	static int16_t audio[40000];
@@ -2002,6 +2037,7 @@ int main(void)
