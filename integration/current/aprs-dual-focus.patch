+static void test_dual_watch_aprs_rx(void)
+{
+	fake_tap.caps = AUDIO_TAP_FM_RX;
+	memset(&pcm, 0, sizeof(pcm));
+	reset();
+	zone.count = 2;
+	zone.channels[1] = 2;
+	chan2.rx_hz = chan2.tx_hz = APRS_HZ;
+	settings_init();
+	radio_sm_init(&sm, now);
+	radio_req_t watch = { RREQ_SCAN, RSCAN_DUAL, 1 };
+	radio_sm_request(&sm, &watch, now);
+	CHECK(sm.scan.kind == SCAN_DUAL);
+	uint32_t on_aprs = 0, on_a = 0;
+	for (int i = 0; i < 400; i++) {
+		run(RADIO_POLL_MS);
+		on_aprs += hw.rx_hz == APRS_HZ;
+		on_a += hw.rx_hz == CH_HZ;
+	}
+	CHECK(on_a > 0 && on_aprs >= 2u * on_a && on_aprs <= 4u * on_a);
+	// A packet: 450 ms of flags (a long TX delay), the frame, a short tail; well over B's dwell
+	static uint8_t tones[512];
+	static int16_t audio[40000];
+	const char *line = "Q1ABC-9>APRS,WIDE2-1:!4903.50N/07201.75W-Heard in dual watch";
+	ax25_frame_t f;
+	uint8_t frame[AX25_FRAME_MAX];
+	CHECK(ax25_from_tnc2(line, strlen(line), &f));
+	f.dst.h = true;
+	size_t n = ax25_encode(&f, frame, sizeof(frame));
+	hdlc_enc_t e;
+	hdlc_enc_init(&e, tones, sizeof(tones));
+	CHECK(hdlc_enc_flags(&e, 68) && hdlc_enc_frame(&e, frame, n) && hdlc_enc_flags(&e, 3));
+	afsk_mod_t m;
+	afsk_mod_init(&m, 8000);
+	memset(audio, 0, sizeof(audio));
+	size_t k = afsk_mod(&m, tones, e.nbits, 8000, audio, sizeof(audio) / sizeof(audio[0]) - 1600);
+	CHECK(k > 8000u * 3u / 4u);	// longer than B's 450 ms dwell
+	// Wait for the watch to come to B, then the packet starts
+	for (int i = 0; i < 200 && hw.rx_hz == APRS_HZ; i++) {
+		run(RADIO_POLL_MS);
+	}
+	for (int i = 0; i < 200 && hw.rx_hz != APRS_HZ; i++) {
